/*
  X-Content-Type-Options: nosniff

/*.wasm
  Content-Type: application/wasm
  Cache-Control: public, max-age=31536000, immutable

# Only Trunk's content-hashed bundle is immutable; raster-worker.js keeps a
# fixed name, so it must revalidate.
/biruni-*.js
  Cache-Control: public, max-age=31536000, immutable

/raster-worker.js
  Cache-Control: public, max-age=300, must-revalidate

/
  Cache-Control: public, max-age=300, must-revalidate

/index.html
  Cache-Control: public, max-age=300, must-revalidate

# Data files have content-hashed names (scripts/hash_data.py), so they never
# change; the manifest that names them must revalidate. Pages merges every
# rule that matches a URL, so these two must not overlap: no /data/* rule.
/data/files/*
  Cache-Control: public, max-age=31536000, immutable

/data/manifest.json
  Cache-Control: public, max-age=60, must-revalidate
